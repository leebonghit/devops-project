global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets:
          - "localhost:9090"
        labels:
          env: "uat"

  - job_name: "node-exporter-uat"
    static_configs:
      - targets:
          - "10.128.0.32:9100"
        labels:
          env: "uat"
          service: "app-server"

  - job_name: "cadvisor-uat"
    static_configs:
      - targets:
          - "10.128.0.32:8080"
        labels:
          env: "uat"
          service: "docker"

  - job_name: "node-exporter-prod"
    static_configs:
      - targets:
          - "10.128.0.14:9100"
        labels:
          env: "prod"
          service: "app-server"

  - job_name: "cadvisor-prod"
    static_configs:
      - targets:
          - "10.128.0.14:8080"
        labels:
          env: "prod"
          service: "docker"
