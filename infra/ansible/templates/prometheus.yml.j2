global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets:
          - "localhost:9090"
        labels:
          env: "uat"

  - job_name: "node-exporter"
    static_configs:
      - targets:
          - "192.168.10.10:9100"
        labels:
          env: "uat"
          service: "app-server"

  - job_name: "cadvisor"
    static_configs:
      - targets:
          - "192.168.10.10:8080"
        labels:
          env: "uat"
          service: "docker"
