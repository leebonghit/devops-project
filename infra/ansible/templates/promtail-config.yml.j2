server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://{{ hostvars['monitoring-host']['ansible_host'] }}:3100/loki/api/v1/push

scrape_configs:
  - job_name: docker
    static_configs:
      - targets:
          - localhost
        labels:
          job: docker
          env: "{{ log_env }}"
          host: "{{ inventory_hostname }}"
          __path__: /var/lib/docker/containers/*/*-json.log
